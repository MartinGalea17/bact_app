import json
import streamlit as st

with open("reporting_rules.json") as f:
    rules = json.load(f)

organism = st.selectbox("Organism", sorted(rules.keys()))

sample_type = st.selectbox(
    "Sample type",
    list(rules[organism].keys())
)

result = rules[organism][sample_type]

if result["follow"]:
    st.success("✅ Follow this organism")
else:
    st.error("❌ Do not follow")

st.write("**Guidance:**")
st.write(result["report"])
