{
  "name": "haemophilus influenzae",
  "hinf_cef_pos":"Beta-lactamase detected",
  "hinf_cef_neg":"Beta-lactamase not detected",
  "hinf_no_mechanism_detected":"TEST",
  "hinf_mechanism_detected":"TEST",
  "hinf_furthur_testing":"Test for Beta- lactamase", 
  "hinf_beta_lactam_pos": "Mechanism: beta-lacamase with or without PBP3 mutations",
  "hinf_beta_lactam_neg": "Mechanism: PBP3 mutations",
  "hinf_Aug_>15":"Mechanism: beta-lactamase only",
  "hing_Aug_<15":"Mechanism: beta-lactamase and PBP3 mutations"
}




import json


with open("h_inf.json") as f:
    hinf_messages = json.load(f)
# haemophilus logic 



def check_factors(x,v,XV):
    if (x,v,XV) == (0,0,1):
        return "influenzae_group"
    elif (x,v,XV) == (1,0,1):
        return "haemolyticus_group"
    elif (x,v,XV) == (0,1,1):
        return "parainfluenzae_group"
    else:
        return None
    

def check_heamolysis(group_result,heamolysis_input):
    if group_result == "haemolyticus_group":
        if heamolysis_input == 1:
            return "H. haemolyticus"
        else:
            return "H.ducreyi"
    elif group_result == "parainfluenzae_group":
        if heamolysis_input == 1:
            return "H. parahaemolyticus"
        else:
            return "H. parainfluenzae"
    
    elif group_result == "influenzae_group":
        return "H. influenzae or H. aegyptius"

    return "No Match"

def check_cefinase(haemolyis_result):
    if "H. influenzae" in haemolyis_result:
        cefinase_input = int(input("Input cefinase result: "))
        if cefinase_input == 1:
            print("DEBUG: cefinase input is 1, Beta-lactamase detected")
            return "BLPR"
        elif cefinase_input == 0:
            print("DEBUG: cefinase input is 0, No Beta-lactamase detected")
            return "No enzyme"
        else:
            print("DEBUG: Invalid input for cefinase test")
            return "Invalid input for cefinase test. Please enter 1 for positive or 0 for negative."
    else:
        return haemolyis_result
    

def haeinf_logic(cefinase_result, hinf_messages):
    messages = []

    if "H. influenzae" in haemolyis_result:
        penicillin_input = int(input("Input penicillin result in mm : "))
        #no resistance mechanism detected
        if penicillin_input >= 12:
            return hinf_messages["hinf_no_mechanism_detected"]
    
        #below this line resistance exists 
        # showing the first resistance messages 
        messages.append(hinf_messages["hinf_mechanism_detected"])

        print(f"DEBUG: cefinase result = {cefinase_result}, "
            f"penicillin result = {penicillin_input}")

        #beta lacamase testing 
        if cefinase_result == "BLPR":
            messages.append(hinf_messages["hinf_beta_lactam_pos"])

        elif cefinase_result == "NO enzyme":
            messages.append(hinf_messages["hinf_beta_lactam_neg"])
    
        else:
            messages.append("Invalid cefinase result.")
            return "\n".join(messages)

        # Augmentin result
        Aug_input = int(input("Input Augmentin result: "))

        if Aug_input >= 15:
            messages.append(hinf_messages["hinf_Aug_>15"])
        else:
            messages.append(hinf_messages["hinf_Aug_<15"])
    
    
        return "\n".join(messages)



#Main
x = int(input("Input X result: "))
v = int(input("Input V result: "))
XV = int(input("Input XV result: "))
group_result = check_factors(x,v,XV)

if group_result is None:
    print("No match with factors")
else:
    haemolysis_input = int(input("Input haemolysis: "))
    haemolyis_result = check_heamolysis(group_result,haemolysis_input)
    
    print(f"Identification result: {haemolyis_result}")

if haemolyis_result:
    cefinase_result = check_cefinase(haemolyis_result)

if cefinase_result is not None:
    
    h_inf_result = haeinf_logic(cefinase_result, hinf_messages)
    print("\nFinal interpretation:")
    print(h_inf_result)
else:
    print("The resistance mechanism workflow currently only applies "
        "to H. influenzae or H. aegyptius.")




